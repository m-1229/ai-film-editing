# ============================================================
#  大文件与运行产物（绝不入库）
# ============================================================

# whisper 模型（464M，首次运行时自动下载到 models/whisper/）
models/

# 内置 ffmpeg（84M）。找不到时会自动回退到系统 PATH 或 imageio-ffmpeg
bin/

# 内置音乐库（23M）
music/

# 用户视频、成片、转写缓存（数百 M）
projects/
o.mp4

# ============================================================
#  Python 缓存与日志
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

*.log
运行日志.log

# ============================================================
#  开发工具本地产物
# ============================================================
.workbuddy/
.backup/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 测试产生的临时文件
fail_*.log
_*_tmp.py
